---
import fr from '../i18n/fr.json';
const { footer } = fr;
---

<footer class="footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href="/fr/" class="footer-logo" aria-label="ConsoAlert, accueil">
          <svg class="footer-logo-icon" viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <rect width="32" height="32" rx="8" fill="currentColor"/>
            <path d="M8 16C8 16 10 10 16 10C22 10 24 16 24 16C24 16 22 22 16 22C10 22 8 16 8 16Z" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <circle cx="16" cy="16" r="3" fill="white"/>
          </svg>
          <span class="footer-logo-text">ConsoAlert</span>
        </a>
        <p class="footer-tagline">Surveillance intelligente de la consommation électrique 24&nbsp;h/24.</p>
      </div>

      <div class="footer-links-grid">
        <nav class="footer-column" aria-labelledby="footer-product">
          <h2 class="footer-heading" id="footer-product">{footer.product}</h2>
          <ul class="footer-links">
            <li><a href="/fr/#features">Fonctionnalités</a></li>
            <li><a href="/fr/pricing/">Tarifs</a></li>
            <li><a href="/fr/#faq">FAQ</a></li>
          </ul>
        </nav>

        <nav class="footer-column" aria-labelledby="footer-company">
          <h2 class="footer-heading" id="footer-company">{footer.company}</h2>
          <ul class="footer-links">
            <li><a href="/fr/posts/">Blog</a></li>
            <!-- <li><a href="/fr/about/">À propos</a></li> -->
            <li><a href="/fr/contact/">Contact</a></li>
          </ul>
        </nav>

        <nav class="footer-column" aria-labelledby="footer-legal">
          <h2 class="footer-heading" id="footer-legal">{footer.legal}</h2>
          <ul class="footer-links">
            <li><a href="/fr/mentions-legales/">Mentions légales</a></li>
            <!-- <li><a href="/fr/confidentialite/">Confidentialité</a></li>
            <li><a href="/fr/cgv/">CGV</a></li> -->
          </ul>
        </nav>
      </div>
    </div>

    <div class="footer-bottom">
      <p class="footer-copyright">{footer.copyright}</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: var(--color-slate-900);
    padding: var(--spacing-16) 0 var(--spacing-8);
  }

  .footer-top {
    display: grid;
    gap: var(--spacing-12);
    padding-bottom: var(--spacing-12);
    border-bottom: 1px solid var(--color-slate-700);
  }

  @media (min-width: 768px) {
    .footer-top {
      grid-template-columns: 1fr 2fr;
    }
  }

  .footer-logo {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-3);
    color: #fff;
    margin-bottom: var(--spacing-4);
  }

  .footer-logo-icon {
    width: 32px;
    height: 32px;
    color: var(--color-blurple);
  }

  .footer-logo-text {
    font-size: var(--font-size-xl);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .footer-tagline {
    font-size: var(--font-size-sm);
    color: var(--color-text-on-dark-muted);
    max-width: 280px;
  }

  .footer-links-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--spacing-8);
  }

  @media (min-width: 768px) {
    .footer-links-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-12);
    }
  }

  .footer-heading {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: #fff;
    margin-bottom: var(--spacing-4);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .footer-links a {
    font-size: var(--font-size-sm);
    color: var(--color-text-on-dark-muted);
    transition: color var(--transition-fast);
  }

  .footer-links a:hover {
    color: #fff;
  }

  .footer-bottom {
    padding-top: var(--spacing-8);
  }

  .footer-copyright {
    font-size: var(--font-size-sm);
    color: var(--color-text-on-dark-muted);
  }
</style>
