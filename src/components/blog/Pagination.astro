---
interface Props {
  currentPage: number;
  totalPages: number;
  basePath: string;
}

const { currentPage, totalPages, basePath } = Astro.props;
const hrefFor = (page: number) => page === 1 ? basePath : `${basePath}${page}/`;
---

{totalPages > 1 && (
  <nav class="pagination" aria-label="Pagination des articles">
    {currentPage > 1 ? <a class="btn btn--secondary btn--sm" href={hrefFor(currentPage - 1)}>← Articles récents</a> : <span />}
    <span class="pagination-status">Page {currentPage} / {totalPages}</span>
    {currentPage < totalPages ? <a class="btn btn--secondary btn--sm pagination-next" href={hrefFor(currentPage + 1)}>Articles suivants →</a> : <span />}
  </nav>
)}

<style>
  .pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--spacing-4);
    margin-top: var(--spacing-4);
  }

  .pagination > :first-child {
    justify-self: start;
  }

  .pagination-next {
    justify-self: end;
  }

  .pagination-status {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .pagination {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .pagination > :first-child,
    .pagination-next {
      justify-self: center;
    }
  }
</style>
