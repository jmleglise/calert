---
import { formatDate, getPostUrl, getReadingTime, slugify, type BlogPost } from '../../lib/blog';

interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
---

<article class="surface post-card">
  <p class="post-meta">
    <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
    <span aria-hidden="true">·</span>
    <span>{getReadingTime(post)}&nbsp;min de lecture</span>
  </p>
  <h2 class="post-title"><a href={getPostUrl(post)}>{post.data.title}</a></h2>
  <p class="post-excerpt">{post.data.description}</p>
  <ul class="tag-list" aria-label="Sujets de l’article">
    {post.data.tags.map((tag) => <li><a href={`/fr/posts/${slugify(tag)}/`}>#{tag}</a></li>)}
  </ul>
</article>

<style>
  .post-card {
    padding: clamp(var(--spacing-6), 4vw, var(--spacing-8));
    transition: transform var(--transition-fast), box-shadow var(--transition-fast), border-color var(--transition-fast);
  }

  .post-card:hover {
    border-color: var(--color-primary-200);
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
  }

  .post-meta {
    margin-bottom: var(--spacing-3);
  }

  .post-title {
    font-size: var(--font-size-card-title);
    letter-spacing: var(--tracking-tight);
    line-height: 1.3;
    margin-bottom: var(--spacing-3);
  }

  .post-title a:hover {
    color: var(--color-blurple);
  }

  .post-excerpt {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-5);
  }
</style>
