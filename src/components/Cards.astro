---
import fr from '../i18n/fr.json';
import Icon from './Icon.astro';
const { cards } = fr;

// Cartes masquées : "hidden": true dans fr.json (le JSON n'accepte pas de
// commentaire). Retirer la clé pour réafficher la carte et sa modale.
// Carte masquée actuellement : multi-logements.
const items = cards.items.filter((card) => !('hidden' in card && card.hidden));
---

<section class="section cards-section" id="features">
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">{cards.title}</h2>
      <p class="section-lead">{cards.subtitle}</p>
    </div>

    <div class="cards-grid">
      {items.map((card) => (
        <article class="card" data-card={card.id}>
          <div class="card-top">
            <h3 class="card-title">{card.cardTitle}</h3>
            <button
              class="card-expand-btn"
              data-card-open={card.id}
              aria-haspopup="dialog"
              aria-controls={`modal-${card.id}`}
              aria-label={`Agrandir : ${card.cardTitle}`}
            >
              <Icon name="expand" />
            </button>
          </div>
          <div class={`card-visual ${card.visualClass}`} aria-hidden="true" set:html={card.visualHtml}></div>
          <span class="card-more" aria-hidden="true">
            En savoir plus
            <Icon name="arrow-right" />
          </span>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- Modales -->
{items.map((card) => (
  <div class="modal-overlay" data-modal={card.id} id={`modal-${card.id}`}>
    <div class="modal-panel" role="dialog" aria-modal="true" aria-labelledby={`modal-title-${card.id}`}>

      <button class="modal-close" data-close={card.id} aria-label="Fermer">
        <Icon name="close" />
      </button>

      <div class="modal-scroll">
        <div class="modal-content">
          <div class="modal-col-text">
            <h2 class="modal-title" id={`modal-title-${card.id}`}>{card.title}</h2>
            <div class="modal-body-text">
              {card.body.map((paragraph: string) => (
                <p>{paragraph}</p>
              ))}
            </div>
            <a href="https://app.consoalert.com/auth" class="btn btn--primary">
              {cards.cta}
              <Icon name="arrow-right" class="btn-arrow" />
            </a>
          </div>

          <div class="modal-col-bullets">
            <ul class="modal-bullets">
              {card.bullets.map((bullet: string) => (
                <li class="modal-bullet">
                  <span class="list-icon"><Icon name="check" /></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- Aperçu schématique du tableau de bord -->
        <div class="modal-preview" aria-hidden="true">
          <div class="preview-bar">
            <span class="preview-dot"></span>
            <span class="preview-dot"></span>
            <span class="preview-dot"></span>
            <span class="preview-url">app.consoalert.com — Tableau de bord Wattson</span>
          </div>
          <div class="preview-screen">
            <div class="preview-sidebar">
              <div class="preview-nav-item active-nav"></div>
              <div class="preview-nav-item"></div>
              <div class="preview-nav-item"></div>
              <div class="preview-nav-item"></div>
            </div>
            <div class="preview-main">
              <div class="preview-row">
                <div class="preview-card-sm gradient-blue"></div>
                <div class="preview-card-sm gradient-green"></div>
                <div class="preview-card-sm gradient-red"></div>
              </div>
              <div class="preview-chart-area">
                <svg viewBox="0 0 400 100" preserveAspectRatio="none" class="preview-chart-svg">
                  <polyline points="0,80 50,70 100,60 150,65 200,30 250,25 300,35 350,20 400,25" fill="none" stroke="#635BFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <polyline points="0,80 50,70 100,60 150,65 200,30 250,25 300,35 350,20 400,25 400,100 0,100" fill={`url(#preview-fill-${card.id})`} stroke="none"/>
                  <defs>
                    <linearGradient id={`preview-fill-${card.id}`} x1="0%" y1="0%" x2="0%" y2="100%">
                      <stop offset="0%" stop-color="#635BFF" stop-opacity="0.15"/>
                      <stop offset="100%" stop-color="#635BFF" stop-opacity="0"/>
                    </linearGradient>
                  </defs>
                </svg>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>
))}

<style is:global>
  /* ────────────────── GRILLE ────────────────── */
  .cards-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-6);
  }

  @media (min-width: 768px) {
    .cards-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .cards-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* ────────────────── CARTE ────────────────── */
  .card {
    display: grid;
    grid-template-rows: auto 1fr auto;
    grid-template-areas: 'top' 'visual' 'more';
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border);
    background: #fff;
    box-shadow: var(--shadow-sm);
    overflow: hidden;
    cursor: pointer;
    transition: box-shadow var(--transition-normal), transform var(--transition-normal),
      border-color var(--transition-normal);
  }

  .card:hover {
    box-shadow: var(--shadow-lg);
    transform: translateY(-2px);
    border-color: var(--color-primary-200);
  }

  /* Dernière carte seule sur sa ligne : elle prend toute la largeur,
     texte à gauche, visuel à droite. */
  @media (min-width: 768px) and (max-width: 1023px) {
    .card:last-child:nth-child(odd) {
      grid-column: 1 / -1;
      min-height: 300px;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: 1fr auto;
      grid-template-areas: 'top visual' 'more visual';
    }

    .card:last-child:nth-child(odd) .card-visual {
      margin-top: 0;
      align-items: center;
    }

    .card:last-child:nth-child(odd) .card-visual > [class$='-content'] {
      width: 100%;
      max-width: 520px;
    }
  }

  @media (min-width: 1024px) {
    .card:last-child:nth-child(3n + 1) {
      grid-column: 1 / -1;
      min-height: 300px;
      grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
      grid-template-rows: 1fr auto;
      grid-template-areas: 'top visual' 'more visual';
    }

    .card:last-child:nth-child(3n + 1) .card-visual {
      margin-top: 0;
      align-items: center;
    }

    .card:last-child:nth-child(3n + 1) .card-visual > [class$='-content'] {
      width: 100%;
      max-width: 520px;
    }
  }

  .card-top {
    grid-area: top;
    padding: var(--spacing-8) var(--spacing-8) 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--spacing-3);
  }

  .card-title {
    font-size: var(--font-size-lg);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-primary);
  }

  .card-expand-btn {
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    border-radius: var(--radius-md);
    background: var(--color-slate-100);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-slate-600);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .card-expand-btn svg {
    width: 18px;
    height: 18px;
  }

  .card:hover .card-expand-btn {
    background: var(--color-blurple);
    color: #fff;
  }

  .card-more {
    grid-area: more;
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
    padding: var(--spacing-3) var(--spacing-8) var(--spacing-6);
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-link);
  }

  .card-more svg {
    width: 16px;
    height: 16px;
    transition: transform var(--transition-fast);
  }

  .card:hover .card-more svg {
    transform: translateX(3px);
  }

  /* ────────────────── VISUELS ────────────────── */
  /* Zone d'illustration de hauteur commune : les visuels sont dimensionnés
     pour la remplir, centrés verticalement. */
  .card-visual {
    grid-area: visual;
    position: relative;
    overflow: hidden;
    margin-top: var(--spacing-4);
    min-height: 216px;
    display: flex;
    flex-direction: column;
  }

  .card-visual > [class$='-bg'] {
    position: absolute;
    inset: 0;
  }

  .card-visual > [class$='-content'],
  .card-visual > .heater-chart {
    position: relative;
    z-index: 1;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--spacing-4) var(--spacing-8) var(--spacing-5);
  }

  /* Libellé discret en capitales, commun à plusieurs visuels. */
  .chart-label-empty,
  .ev-label {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: var(--spacing-2);
  }

  /* ── Chauffage (conciergerie) ── */
  .heater-bg { background: linear-gradient(160deg, #fff7ed 0%, #fff 100%); }

  .chart-bars {
    display: flex;
    align-items: flex-end;
    gap: var(--spacing-2);
    height: 110px;
    margin-bottom: var(--spacing-2);
  }

  .bar {
    flex: 1;
    background: var(--color-slate-200);
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
  }

  .bar-alert {
    background: linear-gradient(180deg, #fb923c, var(--color-error-500));
  }

  .alert-badge {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: var(--spacing-2);
    background: var(--color-error-50);
    border: 1px solid var(--color-error-200);
    color: var(--color-text-danger);
    font-size: var(--font-size-xs);
    font-weight: 600;
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-full);
  }

  .alert-dot {
    width: 8px;
    height: 8px;
    background: var(--color-error-500);
    border-radius: 50%;
    animation: pulse 1.5s ease-in-out 3;
  }

  /* ── Budget ── */
  .savings-bg { background: linear-gradient(160deg, var(--color-primary-50) 0%, #fff 60%); }

  .visual-savings .savings-content {
    flex-direction: row;
    align-items: center;
    gap: var(--spacing-4);
  }

  .savings-ring svg {
    width: 96px;
    height: 96px;
  }

  .savings-items {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .saving-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .saving-label {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-2);
  }

  .saving-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-heat { background: var(--color-blurple); }
  .dot-water { background: #0EA5E9; }
  .dot-other { background: var(--color-slate-300); }

  .saving-value {
    font-weight: 600;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .saving-item.bold {
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .saving-value.positive { color: var(--color-text-success); }

  .saving-divider {
    height: 1px;
    background: var(--color-border);
    margin: var(--spacing-1) 0;
  }

  /* ── Recharge VE ── */
  .ev-bg { background: linear-gradient(160deg, #f0f9ff 0%, #fff 70%); }

  .visual-ev .ev-content {
    gap: var(--spacing-4);
  }

  .ev-timeline {
    display: flex;
    align-items: flex-end;
    gap: 5px;
    height: 72px;
  }

  .ev-slot {
    flex: 1;
    background: var(--color-slate-100);
    border-radius: var(--radius-xs) var(--radius-xs) 0 0;
  }

  .ev-charging {
    background: linear-gradient(180deg, #38bdf8, #0284c7);
  }

  .ev-hours {
    display: flex;
    justify-content: space-between;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-top: var(--spacing-1);
  }

  .ev-cost-badge {
    display: flex;
    align-items: baseline;
    gap: var(--spacing-2);
    background: #dcfce7;
    border: 1px solid #bbf7d0;
    border-radius: var(--radius-md);
    padding: var(--spacing-2) var(--spacing-4);
  }

  .ev-cost-value {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text-success);
  }

  .ev-cost-label {
    font-size: var(--font-size-sm);
    color: var(--color-text-success);
  }

  /* ── Climatisation (résidence secondaire) ── */
  .clim-bg { background: linear-gradient(160deg, #eff6ff 0%, #fff 70%); }

  .visual-clim .clim-content {
    align-items: center;
    gap: var(--spacing-3);
  }

  .clim-gauge svg { width: 180px; height: 99px; }

  .clim-stats {
    display: flex;
    gap: var(--spacing-10);
  }

  .clim-stat {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .clim-stat-v {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text-primary);
  }

  .clim-stat-l {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  /* ── Logement vacant ── */
  .mining-bg { background: linear-gradient(160deg, #fff1f2 0%, #fff 60%); }

  .visual-mining .mining-content,
  .visual-fault .fault-content {
    padding-left: 0;
    padding-right: 0;
    gap: var(--spacing-3);
  }

  .mining-line {
    height: 90px;
    overflow: hidden;
  }

  .mining-line svg,
  .fault-signal svg {
    width: 100%;
    height: 100%;
  }

  .mining-alert {
    padding: 0 var(--spacing-8);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-3);
  }

  .mining-big {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    display: block;
    white-space: nowrap;
  }

  .mining-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .mining-loss {
    background: var(--color-error-50);
    border: 1px solid var(--color-error-200);
    color: var(--color-text-danger);
    font-size: var(--font-size-sm);
    font-weight: 700;
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  /* ── Anomalies ── */
  .fault-bg { background: linear-gradient(160deg, var(--color-error-50) 0%, #fff 60%); }

  .fault-signal {
    height: 48px;
    overflow: hidden;
  }

  .fault-alerts {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
    padding: 0 var(--spacing-8);
  }

  .fault-alert {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-2) var(--spacing-3);
    background: var(--color-slate-50);
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
  }

  .fault-alert.critical {
    background: var(--color-error-50);
    border-color: var(--color-error-200);
  }

  .fault-time {
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-slate-600);
    font-variant-numeric: tabular-nums;
    width: 36px;
  }

  .fault-msg {
    font-size: var(--font-size-xs);
    color: var(--color-slate-700);
  }

  .fault-alert.critical .fault-msg {
    color: var(--color-text-danger);
    font-weight: 600;
  }

  /* ── Activation en 3 étapes ── */
  .steps-bg { background: linear-gradient(160deg, var(--color-primary-50) 0%, #fff 60%); }

  .visual-steps .steps-content {
    gap: var(--spacing-3);
  }

  .steps-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .step {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-2) var(--spacing-3);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
  }

  .step-mark {
    flex-shrink: 0;
    width: 28px;
    height: 28px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 700;
  }

  .step-mark svg {
    width: 14px;
    height: 14px;
  }

  .step.done .step-mark {
    background: #dcfce7;
    color: var(--color-text-success);
  }

  .step.active {
    border-color: var(--color-primary-200);
    box-shadow: 0 0 0 3px var(--color-primary-50);
  }

  .step.active .step-mark {
    background: var(--color-blurple);
    color: #fff;
  }

  .step-text {
    display: flex;
    flex-direction: column;
  }

  .step-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .step-sub {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  /* ── Calendriers ── */
  .ical-bg { background: linear-gradient(160deg, var(--color-success-50) 0%, #fff 60%); }

  .visual-ical .ical-content {
    gap: var(--spacing-4);
  }

  .ical-sources {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .ical-source {
    display: flex;
    align-items: center;
    gap: var(--spacing-2);
    font-size: var(--font-size-sm);
    color: var(--color-slate-700);
    font-weight: 500;
  }

  .source-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
  }

  .dot-airbnb { background: #e11d48; }
  .dot-booking { background: #003580; }
  .dot-abritel { background: #f97316; }

  .source-status {
    margin-left: auto;
    font-size: var(--font-size-xs);
    font-weight: 600;
    padding: 2px var(--spacing-2);
    border-radius: var(--radius-full);
  }

  .source-status.synced {
    background: #dcfce7;
    color: var(--color-text-success);
  }

  .ical-calendar {
    background: #fff;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border);
    padding: var(--spacing-3);
  }

  .ical-week {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: var(--spacing-1);
  }

  .ical-day-label {
    text-align: center;
    font-size: var(--font-size-xs);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    padding: var(--spacing-1) 0;
  }

  .ical-day {
    text-align: center;
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-slate-700);
    padding: var(--spacing-2) var(--spacing-1);
    border-radius: var(--radius-sm);
  }

  .ical-day.empty { color: var(--color-text-muted); }
  .ical-day.occupied { color: #fff; font-weight: 600; }
  .airbnb-day { background: #e11d48; }
  .booking-day { background: #003580; }

  /* ── Tableau de bord (multi-logements, parties communes) ── */
  .dashboard-bg { background: linear-gradient(160deg, var(--color-slate-50) 0%, #fff 60%); }

  .dash-properties {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .dash-prop {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-2) var(--spacing-3);
    border-radius: var(--radius-md);
    background: var(--color-slate-50);
    border: 1px solid var(--color-border);
  }

  .dash-prop.alert {
    background: var(--color-error-50);
    border-color: var(--color-error-200);
  }

  .prop-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .dot-ok { background: var(--color-success-500); }
  .dot-alert { background: var(--color-error-500); animation: pulse 1.5s ease-in-out 3; }

  .prop-info {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .prop-name {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-slate-800);
  }

  .prop-status {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .prop-status.alert-status {
    color: var(--color-text-danger);
    font-weight: 600;
  }

  /* ────────────────── MODALES ────────────────── */
  .modal-overlay {
    position: fixed;
    inset: 0;
    background: rgb(10 37 64 / 0.6);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    z-index: 200;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--transition-normal), visibility var(--transition-normal);
  }

  @media (min-width: 768px) {
    .modal-overlay {
      align-items: center;
      padding: var(--spacing-8);
    }
  }

  .modal-overlay.active {
    opacity: 1;
    visibility: visible;
  }

  .modal-panel {
    background: #fff;
    width: 100%;
    max-width: 900px;
    max-height: 92vh;
    border-radius: var(--radius-xl) var(--radius-xl) 0 0;
    position: relative;
    transform: translateY(40px);
    transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 768px) {
    .modal-panel {
      border-radius: var(--radius-xl);
    }
  }

  .modal-overlay.active .modal-panel {
    transform: translateY(0);
  }

  .modal-close {
    position: absolute;
    top: var(--spacing-5);
    right: var(--spacing-5);
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-slate-100);
    border-radius: var(--radius-full);
    color: var(--color-slate-600);
    z-index: 10;
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .modal-close:hover {
    background: var(--color-slate-200);
    color: var(--color-text-primary);
  }

  .modal-close svg { width: 18px; height: 18px; }

  .modal-scroll {
    overflow-y: auto;
    flex: 1;
  }

  .modal-content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-8);
    padding: var(--spacing-12) var(--spacing-8) var(--spacing-10);
  }

  @media (min-width: 640px) {
    .modal-content {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-12);
      padding: var(--spacing-12) var(--spacing-12) var(--spacing-10);
    }
  }

  .modal-col-text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--spacing-5);
  }

  .modal-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: var(--tracking-title);
    line-height: 1.25;
    padding-right: var(--spacing-10);
  }

  .modal-body-text {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .modal-body-text p {
    font-size: var(--font-size-base);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }

  .modal-col-bullets {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .modal-bullets {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .modal-bullet {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    font-size: var(--font-size-base);
    font-weight: 500;
    color: var(--color-text-primary);
    line-height: var(--line-height-normal);
  }

  .modal-bullet .list-icon {
    margin-top: 1px;
  }

  /* ── Aperçu schématique ── */
  .modal-preview {
    margin: 0 var(--spacing-8) var(--spacing-8);
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border);
    box-shadow: var(--shadow-md);
    background: var(--color-slate-50);
  }

  @media (min-width: 640px) {
    .modal-preview {
      margin: 0 var(--spacing-12) var(--spacing-12);
    }
  }

  .preview-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: var(--spacing-3) var(--spacing-4);
    background: var(--color-slate-100);
    border-bottom: 1px solid var(--color-border);
  }

  .preview-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--color-slate-300);
  }

  .preview-url {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    margin-left: var(--spacing-2);
    font-family: var(--font-family-mono);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .preview-screen {
    display: flex;
    height: 180px;
    overflow: hidden;
  }

  .preview-sidebar {
    width: 48px;
    background: var(--color-slate-900);
    flex-shrink: 0;
    padding: var(--spacing-4) 10px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .preview-nav-item {
    height: 8px;
    border-radius: var(--radius-xs);
    background: rgb(255 255 255 / 0.15);
  }

  .active-nav { background: var(--color-blurple); }

  .preview-main {
    flex: 1;
    padding: var(--spacing-4);
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    background: #fff;
  }

  .preview-row {
    display: flex;
    gap: 10px;
  }

  .preview-card-sm {
    flex: 1;
    height: 48px;
    border-radius: var(--radius-md);
    opacity: 0.7;
  }

  .gradient-blue  { background: linear-gradient(135deg, var(--color-primary-500) 0%, var(--color-primary-400) 100%); }
  .gradient-green { background: linear-gradient(135deg, #22c55e 0%, #16a34a 100%); }
  .gradient-red   { background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%); }

  .preview-chart-area {
    flex: 1;
    overflow: hidden;
  }

  .preview-chart-svg {
    width: 100%;
    height: 100%;
  }
</style>

<script>
  const cardEls = document.querySelectorAll<HTMLElement>('.card');
  const overlays = document.querySelectorAll('.modal-overlay');
  const FOCUSABLE =
    'a[href], button:not([disabled]), input, select, textarea, [tabindex]:not([tabindex="-1"])';

  // Élément auquel rendre le focus quand la modale se referme.
  let lastFocused: HTMLElement | null = null;

  const openModal = (cardId: string | undefined, trigger: HTMLElement) => {
    const overlay = document.querySelector(`[data-modal="${cardId}"]`);
    if (!overlay) return;
    lastFocused = trigger;
    overlay.classList.add('active');
    document.body.style.overflow = 'hidden';
    // L'overlay passe de visibility:hidden à visible via une transition :
    // focus() reste sans effet tant que l'élément est encore hidden. On force
    // le recalcul de style, et on retente à la fin de la transition si besoin.
    const focusClose = () => overlay.querySelector<HTMLElement>('.modal-close')?.focus();
    void (overlay as HTMLElement).offsetHeight;
    focusClose();
    if (!overlay.contains(document.activeElement)) {
      overlay.addEventListener('transitionend', focusClose, { once: true });
    }
  };

  cardEls.forEach((card) => {
    card.addEventListener('click', (e) => {
      const trigger = e.target instanceof Element ? e.target.closest('button') : null;
      openModal(card.dataset.card, (trigger as HTMLElement) ?? card);
    });
  });

  const closeModal = () => {
    const wasOpen = document.querySelector('.modal-overlay.active');
    overlays.forEach(o => o.classList.remove('active'));
    document.body.style.overflow = '';
    if (wasOpen && lastFocused) {
      lastFocused.focus();
      lastFocused = null;
    }
  };

  // Piège à focus : Tab ne doit pas sortir de la modale ouverte.
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Tab') return;
    const active = document.querySelector('.modal-overlay.active');
    if (!active) return;

    const items = [...active.querySelectorAll<HTMLElement>(FOCUSABLE)]
      .filter((el) => el.offsetParent !== null);
    if (items.length === 0) return;

    const first = items[0];
    const last = items[items.length - 1];

    if (!(document.activeElement instanceof Element) || !active.contains(document.activeElement)) {
      e.preventDefault();
      first.focus();
      return;
    }

    if (e.shiftKey && document.activeElement === first) {
      e.preventDefault();
      last.focus();
    } else if (!e.shiftKey && document.activeElement === last) {
      e.preventDefault();
      first.focus();
    }
  });

  overlays.forEach(overlay => {
    overlay.addEventListener('click', (e) => {
      // Fermeture au clic sur le fond, hors du panneau.
      const target = e.target;
      if (!(target instanceof Element) || !target.closest('.modal-panel')) {
        closeModal();
      }
    });
  });

  document.querySelectorAll('[data-close]').forEach(btn => {
    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      closeModal();
    });
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });

  // Glisser vers le bas pour fermer sur mobile.
  let touchStartY = 0;
  document.querySelectorAll('.modal-panel').forEach(panel => {
    panel.addEventListener('touchstart', (e) => {
      touchStartY = (e as TouchEvent).touches[0].clientY;
    }, { passive: true });
    panel.addEventListener('touchmove', (e) => {
      if ((e as TouchEvent).touches[0].clientY - touchStartY > 80) closeModal();
    }, { passive: true });
  });
</script>
