---
import fr from '../i18n/fr.json';
import { faqItems as items } from '../data/faq';
import Icon from './Icon.astro';
const { faq } = fr;
---

<section class="section" id="faq">
  <div class="container container--narrow">
    <div class="section-header">
      <h2 class="section-heading">{faq.title}</h2>
    </div>

    <div class="faq-list">
      {items.map((item, index) => (
        <div class="surface faq-item" data-faq-item>
          <h3>
            <button
              class="faq-question"
              data-faq-trigger
              aria-expanded="false"
              aria-controls={`faq-answer-${index}`}
              id={`faq-question-${index}`}
            >
              <span class="faq-question-text">{item.question}</span>
              <span class="faq-icon"><Icon name="close" /></span>
            </button>
          </h3>
          <div
            class="faq-answer"
            data-faq-answer
            id={`faq-answer-${index}`}
            role="region"
            aria-labelledby={`faq-question-${index}`}
          >
            <p class="faq-answer-text">{item.answer}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .faq-item {
    overflow: hidden;
  }

  .faq-question {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--spacing-4);
    padding: var(--spacing-5) var(--spacing-6);
    text-align: left;
    font-size: var(--font-size-lg);
    font-weight: 500;
    line-height: var(--line-height-normal);
    color: var(--color-text-primary);
    transition: color var(--transition-fast);
  }

  .faq-question:hover {
    color: var(--color-blurple);
  }

  .faq-question-text {
    flex: 1;
  }

  .faq-icon {
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-slate-100);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    flex-shrink: 0;
    transition: background var(--transition-normal), color var(--transition-normal);
  }

  /* Croix tournée de 45° : se lit comme un « + » fermé, un « × » ouvert. */
  .faq-icon :global(svg) {
    width: 16px;
    height: 16px;
    transform: rotate(45deg);
    transition: transform var(--transition-normal);
  }

  .faq-item.open .faq-icon {
    background: var(--color-blurple);
    color: #fff;
  }

  .faq-item.open .faq-icon :global(svg) {
    transform: rotate(0deg);
  }

  .faq-answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height var(--transition-normal) ease-out;
  }

  .faq-answer-text {
    padding: 0 var(--spacing-6) var(--spacing-6);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    max-width: var(--measure);
  }
</style>

<script>
  const faqItems = document.querySelectorAll('[data-faq-item]');

  const closeItem = (item: Element) => {
    const trigger = item.querySelector('[data-faq-trigger]');
    const answer = item.querySelector('[data-faq-answer]');

    item.classList.remove('open');
    trigger?.setAttribute('aria-expanded', 'false');

    if (answer instanceof HTMLElement) {
      answer.style.maxHeight = '0px';
    }
  };

  faqItems.forEach(item => {
    const trigger = item.querySelector('[data-faq-trigger]');
    const answer = item.querySelector('[data-faq-answer]');

    if (!(trigger instanceof HTMLElement) || !(answer instanceof HTMLElement)) return;

    trigger.addEventListener('click', () => {
      const isOpen = item.classList.contains('open');

      faqItems.forEach(closeItem);

      if (!isOpen) {
        item.classList.add('open');
        trigger.setAttribute('aria-expanded', 'true');
        answer.style.maxHeight = `${answer.scrollHeight}px`;
      }
    });
  });

  window.addEventListener('resize', () => {
    faqItems.forEach(item => {
      if (!item.classList.contains('open')) return;

      const answer = item.querySelector('[data-faq-answer]');
      if (answer instanceof HTMLElement) {
        answer.style.maxHeight = `${answer.scrollHeight}px`;
      }
    });
  });
</script>
