---
import fr from '../i18n/fr.json';
const { partners } = fr;

// width/height sont les dimensions intrinseques du fichier : elles fixent le
// ratio et reservent la place avant le chargement (sans width, la balise ne
// reservait aucune largeur, d'ou un decalage de mise en page).
// displayHeight aligne optiquement les trois logos, qui sinon s'affichaient
// a 107, 91 et 38 px de haut sous le seul effet du max-width.
const logos = [
  {
    name: 'Airbnb',
    file: '/partner-airbnb.webp',
    width: 126,
    height: 84,
    displayHeight: 40,
  },
  {
    name: 'Booking.com',
    file: '/partner-booking.webp',
    width: 127,
    height: 72,
    displayHeight: 36,
  },
  {
    name: 'Abritel HomeAway',
    file: '/partner-abritel.webp',
    width: 200,
    height: 47,
    displayHeight: 26,
  },
];
---

<section class="partners">
  <div class="partners-container">
    <p class="partners-title">{partners.title}</p>
    <div class="partners-logos">
      {logos.map((logo) => (
        <div class="partner-logo" style={`--logo-height: ${logo.displayHeight}px`}>
          <img
            src={logo.file}
            alt={logo.name}
            width={logo.width}
            height={logo.height}
            loading="lazy"
            decoding="async"
          />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .partners {
    padding: var(--spacing-12) 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.06);
    background: #FFFFFF;
  }

  .partners-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 var(--spacing-6);
    text-align: center;
  }

  .partners-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-slate-400);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--spacing-8);
  }

  .partners-logos {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-8);
  }

  @media (min-width: 768px) {
    .partners-logos {
      gap: var(--spacing-12);
    }
  }

  .partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all var(--transition-normal);
  }

  .partner-logo img {
    display: block;
    height: var(--logo-height);
    width: auto;
    max-width: 160px;
    object-fit: contain;
    /* Grayscale + multiply so white backgrounds vanish on light bg */
    filter: grayscale(100%) opacity(0.55);
    mix-blend-mode: multiply;
    transition: filter var(--transition-normal);
  }

  .partner-logo:hover img {
    filter: grayscale(0%) opacity(1);
  }
</style>
