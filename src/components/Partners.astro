---
import fr from '../i18n/fr.json';
const { partners } = fr;

// width/height sont les dimensions intrinseques du fichier : elles fixent le
// ratio et reservent la place avant le chargement (sans width, la balise ne
// reservait aucune largeur, d'ou un decalage de mise en page).
// displayHeight aligne optiquement les trois logos, dont les fichiers n'ont
// pas le meme ratio.
const logos = [
  {
    name: 'Airbnb',
    file: '/partner-airbnb.webp',
    width: 126,
    height: 84,
    displayHeight: 48,
  },
  {
    name: 'Booking.com',
    file: '/partner-booking.webp',
    width: 127,
    height: 72,
    displayHeight: 44,
  },
  {
    name: 'Abritel HomeAway',
    file: '/partner-abritel.webp',
    width: 200,
    height: 47,
    displayHeight: 32,
  },
];
---

<section class="partners">
  <div class="container">
    <p class="partners-title">{partners.title}</p>
    <ul class="partners-logos">
      {logos.map((logo) => (
        <li class="partner-logo" style={`--logo-height: ${logo.displayHeight}px`}>
          <img
            src={logo.file}
            alt={logo.name}
            width={logo.width}
            height={logo.height}
            loading="lazy"
            decoding="async"
          />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .partners {
    padding: var(--section-y-sm) 0;
    border-bottom: 1px solid var(--color-border);
    background: #fff;
    text-align: center;
  }

  .partners-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    margin-bottom: var(--spacing-6);
  }

  .partners-logos {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: var(--spacing-6);
  }

  @media (min-width: 768px) {
    .partners-logos {
      gap: var(--spacing-16);
    }
  }

  .partner-logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .partner-logo img {
    display: block;
    height: var(--logo-height);
    width: auto;
    max-width: 180px;
    object-fit: contain;
    /* Niveaux de gris + multiply : le fond blanc des fichiers disparaît. */
    filter: grayscale(100%) opacity(0.8);
    mix-blend-mode: multiply;
    transition: filter var(--transition-normal);
  }

  .partner-logo:hover img {
    filter: grayscale(0%) opacity(1);
  }
</style>
