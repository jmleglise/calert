---
import fr from '../i18n/fr.json';
import Icon from './Icon.astro';
const { hero } = fr;
---

<section class="hero">
  <div class="container hero-container">
    <div class="hero-content">
      <h1 class="hero-title">{hero.title}</h1>
      <p class="hero-subtitle">{hero.subtitle}</p>
      <div class="hero-cta-group">
        <a href="https://app.consoalert.com/auth" class="btn btn--primary btn--lg">
          {hero.cta}
          <Icon name="arrow-right" class="btn-arrow" />
        </a>
        <p class="hero-micro">{hero.micro}</p>
      </div>
    </div>
    <div class="hero-visual" aria-hidden="true">
      <div class="hero-card">
        <div class="hero-card-head">
          <span class="wattson-avatar">
            <Icon name="eye" />
          </span>
          <span class="property-name">Villa Tamaris</span>
        </div>
        <div class="alert-content">
          <span class="alert-icon"><Icon name="zap" /></span>
          <div class="alert-text">
            <span class="alert-title">Anomalie détectée</span>
            <span class="alert-desc">Chauffage actif, logement vide</span>
          </div>
          <span class="alert-time">Il y a 2&nbsp;min</span>
        </div>
        <div class="stats-row">
          <div class="stat">
            <span class="stat-value">2,4&nbsp;kWh</span>
            <span class="stat-label">Surconsommation</span>
          </div>
          <div class="stat">
            <span class="stat-value stat-warning">0,5€/24h</span>
            <span class="stat-label">Coût estimé</span>
          </div>
        </div>
      </div>
    </div>
  </div>
  <div class="hero-bg-gradient"></div>
</section>

<style>
  .hero {
    position: relative;
    /* svh et non vh : sur mobile, 100vh inclut la barre d'URL, ce qui poussait
       le CTA sous la ligne de flottaison et faisait sauter la page au scroll. */
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding: calc(var(--header-height) + var(--spacing-8)) 0 var(--spacing-16);
    overflow: hidden;
    background-image: url('/background_abstract-waves.jpg');
    background-image: image-set(
      url('/background_abstract-waves.avif') type('image/avif'),
      url('/background_abstract-waves.webp') type('image/webp'),
      url('/background_abstract-waves.jpg') type('image/jpeg')
    );
    background-size: cover;
    background-position: center 60%;
    background-repeat: no-repeat;
  }

  @supports not (min-height: 100svh) {
    .hero {
      min-height: 100vh;
    }
  }

  .hero-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-12);
    align-items: center;
  }

  @media (min-width: 1024px) {
    .hero-container {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--spacing-16);
    }
  }

  .hero-content {
    animation: slideUp 0.8s ease-out 0.2s both;
  }

  .hero-title {
    font-size: var(--font-size-hero-title);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: var(--tracking-title);
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-6);
  }

  .hero-subtitle {
    font-size: var(--font-size-lg);
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
    margin-bottom: var(--spacing-8);
    max-width: 540px;
  }

  @media (min-width: 768px) {
    .hero-subtitle {
      font-size: var(--font-size-xl);
    }
  }

  .hero-cta-group {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
    align-items: flex-start;
  }

  .hero-micro {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .hero-visual {
    display: flex;
    justify-content: center;
    animation: slideUp 0.8s ease-out 0.4s both;
  }

  .hero-card {
    background: #fff;
    border-radius: var(--radius-2xl);
    padding: var(--spacing-4);
    box-shadow: var(--shadow-2xl);
    border: 1px solid var(--color-border);
    width: 100%;
    max-width: 380px;
  }

  @media (min-width: 768px) {
    .hero-card {
      padding: var(--spacing-6);
    }
  }

  .hero-card-head {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    margin-bottom: var(--spacing-4);
  }

  .wattson-avatar {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-full);
    background: var(--color-blurple);
    color: #fff;
  }

  .wattson-avatar :global(svg) {
    width: 22px;
    height: 22px;
  }

  .property-name {
    font-size: var(--font-size-lg);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .alert-content {
    display: flex;
    align-items: center;
    gap: var(--spacing-3);
    padding: var(--spacing-4);
    background: var(--color-slate-50);
    border-radius: var(--radius-lg);
    margin-bottom: var(--spacing-4);
  }

  .alert-icon {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    background: var(--color-warning-50);
    color: var(--color-text-warning);
  }

  .alert-icon :global(svg) {
    width: 20px;
    height: 20px;
  }

  .alert-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .alert-title {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-primary);
  }

  .alert-desc,
  .alert-time {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .alert-time {
    margin-left: auto;
    white-space: nowrap;
    align-self: flex-start;
  }

  .stats-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--spacing-4);
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--spacing-4);
    background: var(--color-slate-50);
    border-radius: var(--radius-lg);
  }

  .stat-value {
    font-size: var(--font-size-xl);
    font-weight: 700;
    color: var(--color-text-primary);
    white-space: nowrap;
  }

  .stat-warning {
    color: var(--color-text-warning);
  }

  .stat-label {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  .hero-bg-gradient {
    position: absolute;
    inset: 0;
    z-index: 0;
    /* Voile clair côté texte, transparent côté visuel. */
    background: linear-gradient(
      105deg,
      rgb(246 249 252 / 0.92) 0%,
      rgb(246 249 252 / 0.75) 35%,
      rgb(246 249 252 / 0.30) 60%,
      rgb(246 249 252 / 0.10) 100%
    );
    pointer-events: none;
  }

  @media (max-width: 1023px) {
    .hero-bg-gradient {
      background: rgb(246 249 252 / 0.82);
    }
  }
</style>
