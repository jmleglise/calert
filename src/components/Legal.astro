---
import fr from '../i18n/fr.json';
import Icon from './Icon.astro';
const { legal } = fr;
---

<section class="section legal-section" id="legal">
  <div class="container">
    <div class="section-header">
      <h2 class="section-heading">{legal.title}</h2>
      <p class="section-lead">{legal.subtitle}</p>
    </div>

    <div class="legal-grid">
      {legal.sections.map((section) => (
        <article class="surface legal-block">
          <div class="legal-icon">
            <Icon name={section.icon as 'scale' | 'plug'} />
          </div>
          <h3 class="legal-block-title">{section.title}</h3>
          <p class="legal-block-text">{section.content}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .legal-section {
    background: #fff;
  }

  .legal-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-6);
  }

  @media (min-width: 768px) {
    .legal-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .legal-block {
    padding: var(--spacing-8);
  }

  .legal-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary-50);
    border-radius: var(--radius-md);
    color: var(--color-blurple);
    margin-bottom: var(--spacing-5);
  }

  .legal-icon :global(svg) {
    width: 24px;
    height: 24px;
  }

  .legal-block-title {
    font-size: var(--font-size-xl);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-3);
  }

  .legal-block-text {
    line-height: var(--line-height-relaxed);
    color: var(--color-text-secondary);
  }
</style>
