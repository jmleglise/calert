---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';

const features = [
  'Surveillance 7 j/7 via Linky',
  "Détection d'anomalies par IA",
  'Alertes en temps réel',
  'Multi-logements',
  'Synchronisation Airbnb, Booking, Abritel et iCal',
  'Rapports de consommation',
  'Accès à toutes les fonctionnalités actuelles',
];

const futureFeatures = [
  "Wattson a de l'ambition, beaucoup d'ambition.",
  'Wattson deux fois plus intelligent.',
  'Des choses vraiment folles, incroyables.',
  'Des fonctionnalités secrètes.',
];

const notes = {
  monthly: 'Choisissez votre fréquence de paiement. (Spoiler : ça ne changera pas le prix.)',
  yearly: "Vous économisez exactement 0 € par rapport au mensuel. C'est mathématique.",
};

const faq = [
  {
    q: "C'est vraiment gratuit ?",
    a: "Oui. Vraiment. Pas de carte bancaire requise, pas de période d'essai qui se transforme en abonnement. On a écrit «\u00a0gratuit\u00a0» huit fois sur cette page pour être sûrs que ce soit visible.",
  },
  {
    q: 'Quelle est la différence entre les deux formules ?',
    a: 'La période de facturation. C’est tout. 0 €/mois, 0 €/an. Mathématiquement équivalentes. Philosophiquement identiques. Choisissez selon votre humeur.',
  },
  {
    q: 'Est-ce que ça va rester gratuit ?',
    a: 'Les fonctionnalités actuelles : oui, pour toujours. Les nouvelles fonctionnalités à venir : peut-être pas. Et elles seront irrésistibles. Vous vous précipiterez pour y souscrire.',
  },
  {
    q: 'Comment vous financez-vous, alors ?',
    a: "Nous vivons d'oboles, d'espoir et d'un peu de café.",
  },
  {
    q: 'Et si je veux annuler ?',
    a: 'Annuler quoi, exactement ? Votre abonnement à 0 € ? Vous pouvez. Il y a un bouton de suppression de compte bien caché, comme dans les SaaS payants. (On plaisante.)',
  },
];
---

<Layout
  title="Tarifs — surveillance Linky gratuite | ConsoAlert"
  description="Notre grille tarifaire est simple : tout est gratuit. Pour toujours pour les fonctionnalités actuelles."
  canonical="https://www.consoalert.com/fr/pricing/"
>
  <Header />

  <main id="main">

    <PageHero title="La page tarifs la plus" accent="simple (*) du SaaS.">
      <p>(*) Pas d'astérisque, pas de freemium, pas de période d'essai ni de CB. Juste Wattson, qui bosse pour vous.</p>

      <div class="billing-toggle" role="group" aria-label="Fréquence de facturation">
        <button class="toggle-btn" data-period="monthly" aria-pressed="true">Mensuel</button>
        <button class="toggle-btn" data-period="yearly" aria-pressed="false">Annuel</button>
      </div>
      <p class="toggle-note" id="toggle-note" aria-live="polite">{notes.monthly}</p>
    </PageHero>

    <section class="section plans-section">
      <div class="container">
        <div class="plans-grid">

          <div class="plan-card">
            <div class="plan-header">
              <p class="plan-label">Mensuel</p>
              <p class="plan-price">
                <span class="price-amount">0</span>
                <span class="price-currency">€</span>
                <span class="price-period">/mois</span>
              </p>
              <p class="plan-tagline">Payez chaque mois. Enfin, rien.</p>
            </div>
            <a href="https://app.consoalert.com/auth" class="btn btn--secondary btn--block">Commencer, c'est gratuit</a>
            <ul class="plan-features">
              {features.map((feature) => (
                <li class="feature"><span class="list-icon"><Icon name="check" /></span>{feature}</li>
              ))}
            </ul>
            <p class="plan-footnote">
              Aucune carte bancaire requise. (D'ailleurs, on ne saurait pas quoi en faire.)
            </p>
          </div>

          <div class="plan-card plan-featured">
            <p class="plan-badge">La moins chère : économisez 0&nbsp;€</p>
            <div class="plan-header">
              <p class="plan-label">Annuel</p>
              <p class="plan-price">
                <span class="price-amount">0</span>
                <span class="price-currency">€</span>
                <span class="price-period">/an</span>
              </p>
              <p class="plan-tagline">
                Comparez : 0&nbsp;€ × 12&nbsp;mois = 0&nbsp;€/an. <em>Économie substantielle.</em>
              </p>
            </div>
            <a href="https://app.consoalert.com/auth" class="btn btn--primary btn--block">Commencer, c'est gratuit</a>
            <ul class="plan-features">
              {features.map((feature) => (
                <li class="feature"><span class="list-icon"><Icon name="check" /></span>{feature}</li>
              ))}
            </ul>
            <p class="plan-footnote">
              Facturé 0&nbsp;€ en une seule fois par an.<br />
              Annulable à tout moment (en ne faisant rien).
            </p>
          </div>

          <div class="plan-card is-disabled">
            <div class="plan-header">
              <p class="plan-label">Un jour</p>
              <p class="plan-price">
                <span class="price-amount">??,?</span>
                <span class="price-currency">€</span>
                <span class="price-period">/mois</span>
              </p>
              <p class="plan-tagline">À définir, quelque part entre «&nbsp;accessible&nbsp;» et «&nbsp;viable&nbsp;».</p>
            </div>
            <button class="btn btn--secondary btn--block" disabled>
              M'alerter quand c'est prêt
              <Icon name="bell" />
            </button>
            <ul class="plan-features">
              {futureFeatures.map((feature) => (
                <li class="feature"><span class="list-icon list-icon--neutral"><Icon name="lock" /></span>{feature}</li>
              ))}
            </ul>
            <p class="plan-footnote">
              Les fonctionnalités actuelles resteront <strong>toujours gratuites</strong>. C'est écrit ici, sur internet. Donc c'est vrai.
            </p>
          </div>

        </div>
      </div>
    </section>

    <section class="section donation-section">
      <div class="container container--narrow donation-card">
        <span class="donation-icon"><Icon name="coffee" /></span>
        <h2 class="section-heading">Wattson bosse dur pour offrir à son chat une belle vie.</h2>
        <p class="donation-desc">
          ConsoAlert est gratuit, un peu parce qu'on a créé cet outil pour notre propre usage, et beaucoup
          parce que ce n'est pas nous qui bossons : c'est Wattson. Mais si Wattson vous a évité une facture
          salée, repéré un chauffage resté allumé ou déjoué une recharge de VE clandestine, et que vous voulez
          le remercier, vous pouvez lui payer un café.
        </p>
        <p class="donation-desc">
          On ne va pas se mentir : on le transformera en bière, et on ne sera pas peu fiers de se dire que
          notre travail est reconnu.
        </p>
        <div class="donation-actions">
          <a href="https://buymeacoffee.com/consoalert" target="_blank" rel="noopener" class="btn btn--secondary btn--lg">
            <Icon name="coffee" />
            Offrir un café à Wattson
          </a>
          <p class="donation-micro">Sans obligation. Mais avec une immense gratitude.</p>
        </div>
        <ul class="donation-amounts">
          <li class="amount-pill">3&nbsp;€ = 1 café</li>
          <li class="amount-pill">10&nbsp;€ = une pizza de dev</li>
          <li class="amount-pill">50&nbsp;€ = on rêve…</li>
        </ul>
      </div>
    </section>

    <section class="section pricing-faq">
      <div class="container">
        <div class="section-header">
          <h2 class="section-heading">Questions sur les tarifs</h2>
        </div>
        <div class="faq-grid">
          {faq.map((item) => (
            <div class="surface faq-item">
              <h3 class="faq-q">{item.q}</h3>
              <p class="faq-a">{item.a}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  /* ── Sélecteur de période ── */
  .billing-toggle {
    display: inline-flex;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    padding: var(--spacing-1);
    gap: var(--spacing-1);
    box-shadow: var(--shadow-sm);
    margin: var(--spacing-8) 0 var(--spacing-3);
  }

  .toggle-btn {
    min-height: 40px;
    padding: 0 var(--spacing-5);
    border-radius: var(--radius-full);
    font-size: var(--font-size-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    transition: background var(--transition-fast), color var(--transition-fast);
  }

  .toggle-btn[aria-pressed='true'] {
    background: var(--color-blurple);
    color: #fff;
  }

  .toggle-note {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* ── Formules ── */
  .plans-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-6);
    align-items: start;
  }

  @media (min-width: 768px) {
    .plans-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      align-items: stretch;
    }
  }

  .plan-card {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--spacing-8);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
    box-shadow: var(--shadow-sm);
    transition: box-shadow var(--transition-normal), transform var(--transition-normal);
  }

  .plan-card:not(.is-disabled):hover {
    box-shadow: var(--shadow-xl);
    transform: translateY(-3px);
  }

  .plan-card.is-disabled {
    background: repeating-linear-gradient(
      45deg,
      transparent,
      transparent 10px,
      rgb(10 37 64 / 0.02) 10px,
      rgb(10 37 64 / 0.02) 20px
    );
    box-shadow: none;
  }

  .plan-featured {
    background: var(--color-slate-900);
    border-color: var(--color-blurple);
    box-shadow: 0 0 0 2px var(--color-blurple), var(--shadow-xl);
    color: #fff;
  }

  .plan-featured:hover {
    box-shadow: 0 0 0 2px var(--color-blurple), var(--shadow-2xl);
  }

  .plan-badge {
    position: absolute;
    top: -14px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--color-blurple);
    color: #fff;
    font-size: var(--font-size-xs);
    font-weight: 700;
    padding: var(--spacing-1) var(--spacing-4);
    border-radius: var(--radius-full);
    white-space: nowrap;
  }

  .plan-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2);
  }

  .plan-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: var(--tracking-caps);
    color: var(--color-text-muted);
  }

  .plan-price {
    display: flex;
    align-items: baseline;
    gap: 2px;
    line-height: 1;
  }

  .price-amount {
    font-size: var(--font-size-price);
    font-weight: 700;
    letter-spacing: var(--tracking-title);
    color: var(--color-text-primary);
  }

  .price-currency {
    font-size: var(--font-size-2xl);
    font-weight: 600;
    color: var(--color-text-secondary);
    align-self: flex-start;
    margin-top: var(--spacing-2);
  }

  .price-period {
    font-weight: 500;
    color: var(--color-text-muted);
  }

  .plan-tagline {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .plan-tagline em {
    font-weight: 500;
    color: #4ade80;
  }

  .is-disabled .plan-tagline {
    font-style: italic;
  }

  .is-disabled .price-amount,
  .is-disabled .price-currency {
    color: var(--color-text-muted);
  }

  /* Texte clair sur la carte sombre. */
  .plan-featured .plan-label,
  .plan-featured .price-period,
  .plan-featured .price-currency,
  .plan-featured .plan-footnote {
    color: var(--color-text-on-dark-muted);
  }

  .plan-featured .price-amount { color: #fff; }
  .plan-featured .plan-tagline,
  .plan-featured .feature { color: rgb(255 255 255 / 0.85); }

  .plan-featured .list-icon {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .plan-features {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
    flex: 1;
  }

  .feature {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .plan-footnote {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    padding-top: var(--spacing-4);
    border-top: 1px solid var(--color-border);
  }

  .plan-featured .plan-footnote {
    border-top-color: rgb(255 255 255 / 0.1);
  }

  .plan-footnote strong {
    color: var(--color-text-primary);
  }

  /* ── Don ── */
  .donation-card {
    text-align: center;
  }

  .donation-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-full);
    background: #FFDD00;
    color: #1a1a1a;
    margin-bottom: var(--spacing-6);
  }

  .donation-icon :global(svg) {
    width: 28px;
    height: 28px;
  }

  .donation-card .section-heading {
    margin-bottom: var(--spacing-5);
  }

  .donation-desc {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: var(--measure);
    margin: 0 auto var(--spacing-4);
  }

  .donation-actions {
    margin: var(--spacing-8) 0 var(--spacing-6);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--spacing-3);
  }

  .donation-micro {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .donation-amounts {
    list-style: none;
    display: flex;
    gap: var(--spacing-3);
    justify-content: center;
    flex-wrap: wrap;
  }

  .amount-pill {
    background: var(--color-slate-100);
    border: 1px solid var(--color-border);
    color: var(--color-text-secondary);
    font-size: var(--font-size-sm);
    font-weight: 500;
    padding: var(--spacing-2) var(--spacing-4);
    border-radius: var(--radius-full);
  }

  /* ── FAQ tarifs ── */
  .pricing-faq {
    background: #fff;
    border-top: 1px solid var(--color-border);
  }

  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-6);
  }

  @media (min-width: 768px) {
    .faq-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    /* Dernière question seule sur sa ligne : pleine largeur. */
    .faq-item:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  .faq-item {
    padding: var(--spacing-6);
  }

  .faq-q {
    font-size: var(--font-size-base);
    font-weight: 600;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-3);
    line-height: 1.4;
  }

  .faq-a {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
  }
</style>

<script define:vars={{ notes }}>
  // Sélecteur de période : cosmétique, les prix restent à 0.
  const btns = document.querySelectorAll('.toggle-btn');
  const note = document.getElementById('toggle-note');

  btns.forEach((btn) => {
    btn.addEventListener('click', () => {
      btns.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      if (note) note.textContent = notes[btn.dataset.period] ?? notes.monthly;
    });
  });
</script>
