---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';

const TURNSTILE_SITE_KEY = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || '';
---

<Layout
  title="Contact — parlez à l'équipe | ConsoAlert"
  description="Vous voulez contacter Wattson ? Il lira votre message. Mais c'est un humain qui répondra. Wattson est occupé à surveiller vos logements."
  canonical="https://www.consoalert.com/fr/contact/"
>
  <Header />

  <main id="main">

    <PageHero title="Vous voulez contacter" accent="Wattson ?">
      <p>
        Wattson est un agent IA. Il surveille vos logements, détecte les anomalies,
        ne dort jamais et ne prend pas de vacances.
      </p>
      <p><strong>En revanche, il ne répond pas aux e-mails.</strong> C'est un humain qui le fera à sa place.</p>
    </PageHero>

    <section class="section contact-section">
      <div class="container">
        <div class="contact-layout">

          <aside class="contact-aside">
            <div class="surface aside-block">
              <span class="aside-icon"><Icon name="mail" /></span>
              <h2 class="aside-title">Qui sommes-nous ?</h2>
              <ul class="aside-list">
                <li>
                  <span class="list-icon"><Icon name="map-pin" /></span>
                  ConsoAlert et Wattson sont développés à Paris.
                </li>
                <li>
                  <span class="list-icon"><Icon name="clock" /></span>
                  Un humain vous répond sous quelques jours.
                </li>
                <li>
                  <span class="list-icon"><Icon name="shield" /></span>
                  <span>Questions RGPD : consultez les <a href="/fr/mentions-legales/#rgpd">mentions légales</a>.</span>
                </li>
              </ul>
            </div>

            <div class="surface aside-block aside-donation">
              <span class="aside-icon aside-icon--coffee"><Icon name="coffee" /></span>
              <h2 class="aside-title">Offrir un café à Wattson</h2>
              <p class="aside-desc">
                Wattson tourne 24&nbsp;h/24 sans pause. Si son travail vous a aidé,
                vous pouvez lui payer un café : c'est notre seule source de motivation.
              </p>
              <a
                href="https://buymeacoffee.com/consoalert"
                target="_blank"
                rel="noopener"
                class="btn btn--secondary btn--sm"
              >
                <Icon name="coffee" />
                Faire un don
              </a>
              <p class="aside-micro">Sans obligation. Wattson ne vous jugera pas.</p>
            </div>
          </aside>

          <div class="form-wrapper">
            <form class="contact-form" id="contact-form" novalidate>
              <div class="form-row">
                <div class="form-field">
                  <label class="form-label" for="nom">Nom <span class="required-star" aria-hidden="true">*</span></label>
                  <input
                    class="form-input"
                    type="text"
                    id="nom"
                    name="nom"
                    placeholder="Dupont"
                    autocomplete="family-name"
                    aria-describedby="error-nom"
                    required
                  />
                  <span class="field-error" id="error-nom">Ce champ est requis.</span>
                </div>
                <div class="form-field">
                  <label class="form-label" for="prenom">Prénom <span class="required-star" aria-hidden="true">*</span></label>
                  <input
                    class="form-input"
                    type="text"
                    id="prenom"
                    name="prenom"
                    placeholder="Jean"
                    autocomplete="given-name"
                    aria-describedby="error-prenom"
                    required
                  />
                  <span class="field-error" id="error-prenom">Ce champ est requis.</span>
                </div>
              </div>

              <div class="form-field">
                <label class="form-label" for="email">E-mail <span class="required-star" aria-hidden="true">*</span></label>
                <input
                  class="form-input"
                  type="email"
                  id="email"
                  name="email"
                  placeholder="jean.dupont@exemple.fr"
                  autocomplete="email"
                  aria-describedby="error-email"
                  required
                />
                <span class="field-error" id="error-email">Merci d'entrer un e-mail valide.</span>
              </div>

              <div class="form-field">
                <label class="form-label" for="telephone">
                  Téléphone
                  <span class="optional-label">(optionnel)</span>
                </label>
                <input
                  class="form-input"
                  type="tel"
                  id="telephone"
                  name="telephone"
                  placeholder="+33 6 12 34 56 78"
                  autocomplete="tel"
                />
              </div>

              <div class="form-field">
                <label class="form-label" for="message">Message <span class="required-star" aria-hidden="true">*</span></label>
                <textarea
                  class="form-input form-textarea"
                  id="message"
                  name="message"
                  rows="5"
                  placeholder="Bonjour Wattson, …"
                  aria-describedby="error-message"
                  required
                ></textarea>
                <span class="field-error" id="error-message">Le message ne peut pas être vide.</span>
              </div>

              <div id="turnstile-widget" class="turnstile-widget" aria-label="Vérification anti-bot Cloudflare"></div>

              <p class="form-error" id="form-error" role="alert" aria-live="assertive"></p>

              <div class="form-footer">
                <p class="form-required-note"><span aria-hidden="true">*</span> Champs obligatoires</p>
                <button type="submit" class="btn btn--primary" id="submit-btn">
                  Envoyer à Wattson
                  <Icon name="arrow-right" class="btn-arrow" />
                </button>
              </div>
            </form>

            <div class="success-state" id="success-state" aria-hidden="true">
              <span class="success-icon"><Icon name="check-circle" /></span>
              <h2 class="success-title">Wattson a reçu votre message.</h2>
              <p class="success-desc">
                Il l'a analysé, catégorisé et transmis à un humain en 0,003 seconde.
                L'humain, lui, prendra un peu plus de temps. Il fait avec les moyens du bord.
              </p>
              <p class="success-desc">
                On vous répondra dès que possible, c'est-à-dire dès qu'on aura bu notre café.
              </p>
              <a href="/fr/" class="btn btn--secondary">Retour à l'accueil</a>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--spacing-8);
    align-items: start;
  }

  @media (min-width: 960px) {
    .contact-layout {
      grid-template-columns: 340px minmax(0, 1fr);
      gap: var(--spacing-12);
    }
  }

  /* Formulaire en premier sur mobile : c'est l'action principale de la page. */
  @media (max-width: 959px) {
    .contact-aside {
      order: 2;
    }
  }

  /* ── Colonne latérale ── */
  .contact-aside {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-6);
  }

  .aside-block {
    padding: var(--spacing-6);
  }

  .aside-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: var(--color-primary-50);
    color: var(--color-blurple);
    margin-bottom: var(--spacing-4);
  }

  .aside-icon :global(svg) {
    width: 22px;
    height: 22px;
  }

  .aside-icon--coffee {
    background: #FFDD00;
    color: #1a1a1a;
  }

  .aside-title {
    font-size: var(--font-size-base);
    font-weight: 700;
    color: var(--color-text-primary);
    margin-bottom: var(--spacing-4);
  }

  .aside-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-3);
  }

  .aside-list li {
    display: flex;
    align-items: flex-start;
    gap: var(--spacing-3);
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
  }

  .aside-list a {
    color: var(--color-text-link);
    font-weight: 600;
  }

  .aside-desc {
    font-size: var(--font-size-sm);
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    margin-bottom: var(--spacing-4);
  }

  .aside-micro {
    margin-top: var(--spacing-3);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    font-style: italic;
  }

  /* ── Formulaire ── */
  .form-wrapper {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    padding: clamp(var(--spacing-6), 4vw, var(--spacing-10));
    box-shadow: var(--shadow-sm);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-5);
  }

  .form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--spacing-4);
  }

  @media (max-width: 640px) {
    .form-row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--spacing-5);
    }
  }

  .form-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-label {
    font-size: var(--font-size-sm);
    font-weight: 600;
    color: var(--color-text-primary);
    display: flex;
    align-items: center;
    gap: var(--spacing-1);
  }

  .required-star {
    color: var(--color-text-danger);
  }

  .optional-label {
    font-size: var(--font-size-xs);
    font-weight: 400;
    color: var(--color-text-muted);
  }

  /* 16 px minimum : en dessous, iOS Safari zoome au focus. */
  .form-input {
    font-family: inherit;
    font-size: var(--font-size-base);
    color: var(--color-text-primary);
    background: var(--color-slate-50);
    border: 1.5px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: var(--spacing-3) var(--spacing-4);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast),
      background var(--transition-fast);
    outline: none;
    width: 100%;
  }

  .form-input::placeholder {
    color: var(--color-slate-400);
  }

  .form-input:focus {
    border-color: var(--color-blurple);
    background: #fff;
    box-shadow: 0 0 0 3px var(--color-primary-200);
  }

  .form-input.invalid {
    border-color: var(--color-error-500);
    box-shadow: 0 0 0 3px var(--color-error-200);
  }

  .form-textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.6;
  }

  .field-error {
    font-size: var(--font-size-xs);
    color: var(--color-text-danger);
    display: none;
  }

  .field-error.visible {
    display: block;
  }

  .form-error {
    font-size: var(--font-size-sm);
    color: var(--color-text-danger);
  }

  .form-error:empty {
    display: none;
  }

  .form-footer {
    display: flex;
    flex-direction: column-reverse;
    gap: var(--spacing-4);
    align-items: stretch;
    padding-top: var(--spacing-2);
  }

  @media (min-width: 640px) {
    .form-footer {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
    }
  }

  .form-required-note {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
  }

  /* ── Confirmation ── */
  .success-state {
    display: none;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: var(--spacing-12) var(--spacing-4);
    gap: var(--spacing-4);
  }

  .success-state.visible {
    display: flex;
  }

  .success-icon {
    color: var(--color-text-success);
    animation: pop-in 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  .success-icon :global(svg) {
    width: 48px;
    height: 48px;
  }

  @keyframes pop-in {
    from { transform: scale(0); opacity: 0; }
    to   { transform: scale(1); opacity: 1; }
  }

  .success-title {
    font-size: var(--font-size-2xl);
    font-weight: 700;
    color: var(--color-text-primary);
    letter-spacing: -0.02em;
  }

  .success-desc {
    color: var(--color-text-secondary);
    line-height: var(--line-height-relaxed);
    max-width: 440px;
  }
</style>
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

<script define:vars={{ turnstileSiteKey: TURNSTILE_SITE_KEY }}>
  const form = document.getElementById('contact-form');
  const successState = document.getElementById('success-state');
  const formError = document.getElementById('form-error');
  const submitBtn = document.getElementById('submit-btn');
  const turnstileInitError = 'La vérification anti-robot ne peut pas être chargée. Votre message ne peut pas être envoyé pour le moment.';
  const genericFormError = 'Impossible d’envoyer le message. Merci de réessayer plus tard.';
  let turnstileWidgetId = null;

  function setFormError(message) {
    if (formError) {
      formError.textContent = message || genericFormError;
    }
  }

  function clearFormError() {
    if (formError) {
      formError.textContent = '';
    }
  }

  function validateField(input) {
    const error = document.getElementById(`error-${input.id}`);
    let valid = true;

    if (input.required && !input.value.trim()) {
      valid = false;
    } else if (input.type === 'email' && input.value.trim()) {
      valid = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value.trim());
    }

    input.classList.toggle('invalid', !valid);
    input.setAttribute('aria-invalid', String(!valid));
    error?.classList.toggle('visible', !valid);
    return valid;
  }

  function initTurnstile() {
    const widgetHost = document.getElementById('turnstile-widget');

    if (!turnstileSiteKey || !widgetHost || !window.turnstile) {
      setFormError(turnstileInitError);
      if (submitBtn) submitBtn.disabled = true;
      return;
    }

    turnstileWidgetId = window.turnstile.render(widgetHost, {
      sitekey: turnstileSiteKey,
      action: 'contact',
      callback() {
        clearFormError();
      },
    });
  }

  if (document.readyState === 'complete') {
    initTurnstile();
  } else {
    window.addEventListener('load', initTurnstile);
  }

  form?.querySelectorAll('input, textarea').forEach(field => {
    field.addEventListener('blur', () => {
      if (field.value.trim() !== '' || field.classList.contains('invalid')) {
        validateField(field);
      }
    });
    field.addEventListener('input', () => {
      if (field.classList.contains('invalid')) validateField(field);
    });
  });

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    clearFormError();

    const fields = form.querySelectorAll('[required]');
    let allValid = true;
    fields.forEach((field) => {
      if (!validateField(field)) allValid = false;
    });

    if (!allValid) {
      setFormError('Merci de corriger les champs en erreur.');
      form.querySelector('.invalid')?.focus();
      return;
    }

    const token = turnstileWidgetId !== null && window.turnstile ? window.turnstile.getResponse(turnstileWidgetId) : '';
    if (!token) {
      setFormError('Veuillez confirmer que vous n’êtes pas un robot.');
      if (window.turnstile && turnstileWidgetId !== null) {
        window.turnstile.reset(turnstileWidgetId);
      }
      return;
    }

    if (submitBtn) {
      submitBtn.disabled = true;
      submitBtn.setAttribute('aria-busy', 'true');
    }

    const payload = {
      nom: form.nom.value.trim(),
      prenom: form.prenom.value.trim(),
      email: form.email.value.trim(),
      telephone: form.telephone.value.trim(),
      message: form.message.value.trim(),
      turnstileToken: token,
    };

    try {
      const response = await fetch('/contact', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload),
      });

      const responseText = await response.text();
      let result = null;

      if (responseText) {
        try {
          result = JSON.parse(responseText);
        } catch {
          result = null;
        }
      }

      if (!response.ok || result?.success !== true) {
        if (window.turnstile && turnstileWidgetId !== null) {
          window.turnstile.reset(turnstileWidgetId);
        }

        console.error('Contact form submission failed', {
          status: response.status,
          requestId: result?.requestId || response.headers.get('X-Contact-Request-Id'),
          code: result?.code,
          diagnostic: result?.diagnostic,
          detail: result?.detail,
          response: result,
        });

        setFormError(result?.error || genericFormError);
        return;
      }

      form.style.display = 'none';
      if (successState) {
        successState.removeAttribute('aria-hidden');
        successState.classList.add('visible');
      }
    } catch (err) {
      console.error('Contact form request crashed before receiving a response', err);

      if (window.turnstile && turnstileWidgetId !== null) {
        window.turnstile.reset(turnstileWidgetId);
      }
      setFormError(genericFormError);
    } finally {
      if (submitBtn) {
        submitBtn.disabled = false;
        submitBtn.removeAttribute('aria-busy');
      }
    }
  });
</script>
