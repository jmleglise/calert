---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PageHero from '../../../components/PageHero.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Pagination from '../../../components/blog/Pagination.astro';
import TagList from '../../../components/blog/TagList.astro';
import { getAbsoluteUrl, getPublishedPosts, getTrendingTags, paginate } from '../../../lib/blog';
import '../../../styles/blog.css';

const posts = await getPublishedPosts();
const tags = getTrendingTags(posts);
const page = paginate(posts);
const title = 'Linky, surveillance automatisée et location courte durée';
const description = 'Apprenez-en plus sur le service ConsoAlert, ses fonctionnalités, son intelligence artificielle, et comment surveiller la consommation électrique de vos locations saisonnières et résidences secondaires pour les protéger.';
---

<Layout
  title={`${title} | ConsoAlert`}
  description={description}
  canonical={getAbsoluteUrl('/fr/posts/')}
  alternates={[{ lang: 'fr', href: getAbsoluteUrl('/fr/posts/') }, { lang: 'x-default', href: getAbsoluteUrl('/fr/posts/') }]}
>
  <Header />
  <main id="main">
    <PageHero eyebrow="Blog" title={title}>
      <p>{description}</p>
    </PageHero>

    <section class="blog-section">
      <div class="container blog-shell">
        <div class="post-list" aria-label="Articles récents">
          {page.items.map((post) => <PostCard post={post} />)}
          <Pagination currentPage={page.currentPage} totalPages={page.totalPages} basePath="/fr/posts/" />
        </div>
        <aside class="blog-sidebar">
          <TagList tags={tags} />
        </aside>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
