---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import Pagination from '../../../components/blog/Pagination.astro';
import TagList from '../../../components/blog/TagList.astro';
import PageHero from '../../../components/PageHero.astro';
import Icon from '../../../components/Icon.astro';
import '../../../styles/blog.css';
import {
  POSTS_PER_PAGE,
  formatDate,
  getAbsoluteUrl,
  getAllTags,
  getPaginationUrl,
  getPostSlug,
  getPostUrl,
  getPostsByTag,
  getPublishedPosts,
  getReadingTime,
  getTrendingTags,
  paginate,
  slugify,
  renderMarkdownWithMath,
} from '../../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);
  const paths = [];

  for (const post of posts) {
    paths.push({ params: { slug: getPostSlug(post) }, props: { type: 'post', post } });
  }

  const allPages = Math.ceil(posts.length / POSTS_PER_PAGE);
  for (let page = 2; page <= allPages; page += 1) {
    paths.push({ params: { slug: String(page) }, props: { type: 'list', page } });
  }

  for (const tag of tags) {
    const taggedPosts = getPostsByTag(posts, tag.slug);
    const totalPages = Math.ceil(taggedPosts.length / POSTS_PER_PAGE);
    paths.push({ params: { slug: tag.slug }, props: { type: 'tag', tag, page: 1 } });

    for (let page = 2; page <= totalPages; page += 1) {
      paths.push({ params: { slug: `${tag.slug}/${page}` }, props: { type: 'tag', tag, page } });
    }
  }

  return paths;
}

const posts = await getPublishedPosts();
const tags = getTrendingTags(posts);
const { type } = Astro.props;
const isPost = type === 'post';
const post = Astro.props.post;
const tag = Astro.props.tag;
const pageNumber = Astro.props.page ?? 1;
let articleHtml = '';
let hasMath = false;
let headings = [];
let title = '';
let description = '';
let canonical = '';
let alternates = [];
let keywords = [];
let structuredData;
let noindex = false;
let publishedTime;
let modifiedTime;
let ogType = 'website';
let page;
let basePath = '/fr/posts/';
let tocHeadings = [];

if (isPost) {
  const rendered = renderMarkdownWithMath(post.body);
  articleHtml = rendered.html;
  hasMath = rendered.hasMath;
  headings = rendered.headings;
  tocHeadings = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 3);
  title = `${post.data.title} | ConsoAlert`;
  description = post.data.description;
  canonical = getAbsoluteUrl(getPostUrl(post));
  alternates = [{ lang: 'fr', href: canonical }, { lang: 'x-default', href: canonical }];
  keywords = [...new Set([...post.data.tags, ...post.data.keywords])];
  ogType = 'article';
  publishedTime = post.data.pubDate.toISOString();
  modifiedTime = (post.data.updatedDate ?? post.data.pubDate).toISOString();
  structuredData = [{
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    inLanguage: 'fr-FR',
    mainEntityOfPage: canonical,
    url: canonical,
    author: { '@type': 'Organization', name: 'ConsoAlert' },
    publisher: { '@type': 'Organization', name: 'ConsoAlert', url: 'https://www.consoalert.com' },
    keywords,
  }, {
    // Le fil d'Ariane existait visuellement mais n'etait pas declare.
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Accueil', item: getAbsoluteUrl('/fr/') },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: getAbsoluteUrl('/fr/posts/') },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: canonical },
    ],
  }];
} else {
  const isTag = type === 'tag';
  const sourcePosts = isTag ? getPostsByTag(posts, tag.slug) : posts;
  page = paginate(sourcePosts, pageNumber);
  basePath = isTag ? `/fr/posts/${tag.slug}/` : '/fr/posts/';
  const pageTitle = isTag ? `Articles sur ${tag.name}` : 'Articles ConsoAlert';
  title = `${pageTitle}${page.currentPage > 1 ? ` - page ${page.currentPage}` : ''} | ConsoAlert`;
  description = isTag
    ? `Tous les articles ConsoAlert associés au tag ${tag.name}. Conseils Linky, énergie et surveillance des logements.`
    : 'Conseils pratiques pour surveiller vos consommations électriques, détecter les anomalies Linky et protéger vos logements.';
  canonical = getAbsoluteUrl(getPaginationUrl(basePath, page.currentPage));
  alternates = [{ lang: 'fr', href: canonical }, { lang: 'x-default', href: canonical }];
  keywords = isTag ? [tag.name, 'ConsoAlert', 'Linky', 'consommation électrique'] : ['ConsoAlert', 'Linky', 'consommation électrique', 'location courte durée'];
  // Listes de tags et pages de pagination : contenu quasi duplique d'un tag a
  // l'autre. On les garde navigables (follow) mais hors de l'index.
  noindex = true;
}
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  alternates={alternates}
  structuredData={structuredData}
  noindex={noindex}
  math={hasMath}
  ogType={ogType}
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
>
  <Header />
  {isPost ? (
    <main id="main" class="article-page">
      <article class="container">
        <header class="article-header">
          <nav aria-label="Fil d’Ariane" class="breadcrumb">
            <a href="/fr/posts/"><Icon name="arrow-left" />Tous les articles</a>
          </nav>
          <h1 class="page-title">{post.data.title}</h1>
          <p class="article-lead">{post.data.description}</p>
          <p class="post-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>{getReadingTime(post)}&nbsp;min de lecture</span>
          </p>
          <ul class="tag-list" aria-label="Sujets de l’article">
            {post.data.tags.map((tagName) => <li><a href={`/fr/posts/${slugify(tagName)}/`}>#{tagName}</a></li>)}
          </ul>
        </header>

        <div class="article-grid">
          <div class="article-content">
            <Fragment set:html={articleHtml} />
            <aside class="article-cta">
              <h2>Surveillez vos logements avec Wattson</h2>
              <p>Alertes de surconsommation à partir de votre compteur Linky. Sans boîtier, gratuit.</p>
              <a href="https://app.consoalert.com/auth" class="btn btn--primary">
                Commencer, c'est gratuit
                <Icon name="arrow-right" class="btn-arrow" />
              </a>
            </aside>
          </div>
          <aside class="blog-sidebar">
            {tocHeadings.length > 0 && (
              <nav class="surface toc-panel" aria-labelledby="toc-title">
                <h2 id="toc-title">Sommaire</h2>
                <ol>
                  {tocHeadings.map((heading) => <li class={`depth-${heading.depth}`}><a href={`#${heading.slug}`}>{heading.text}</a></li>)}
                </ol>
              </nav>
            )}
            <TagList tags={tags} />
          </aside>
        </div>
      </article>
    </main>
  ) : (
    <main id="main">
      <PageHero
        eyebrow={type === 'tag' ? 'Sujet' : 'Blog'}
        title={type === 'tag' ? `Articles sur ${tag.name}` : 'Articles ConsoAlert'}
      >
        <p>{description}</p>
      </PageHero>
      <section class="blog-section">
        <div class="container blog-shell">
          <div class="post-list">
            {page.items.map((item) => <PostCard post={item} />)}
            <Pagination currentPage={page.currentPage} totalPages={page.totalPages} basePath={basePath} />
          </div>
          <aside class="blog-sidebar"><TagList tags={tags} activeTag={type === 'tag' ? tag.slug : undefined} /></aside>
        </div>
      </section>
    </main>
  )}
  <Footer />
</Layout>
